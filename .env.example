# ==========================================================================
# 환경변수 예시 파일
#
# 사용법:
#   cp .env.example .env
#   nano .env          # 값을 실제 값으로 교체
#
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않는다.
# 이 파일(.env.example)에는 절대 실제 비밀값을 넣지 않는다.
# ==========================================================================

# ---------------------------------------------------------------- 실행 환경
# production | development
FLASK_ENV=production

# ---------------------------------------------------------------- 보안 모드 ★핵심
# secure     : 방어 적용 버전. 외부 공개 가능. (반드시 이 값으로 배포)
# vulnerable : 의도적 취약점 활성화. 호스트 전용 네트워크에서만 사용.
#              절대 Cloudflare Tunnel / 포트포워딩으로 노출하지 말 것.
SECURITY_MODE=secure

# ---------------------------------------------------------------- 시크릿
# 반드시 교체할 것. 생성 방법:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe

# ---------------------------------------------------------------- 데이터베이스
DB_HOST=db
DB_PORT=3306
DB_NAME=vmlab
DB_USER=vmlab
DB_PASSWORD=CHANGE_ME_db_password
DB_POOL_SIZE=5

# MariaDB 컨테이너 초기화용 (docker-compose 의 db 서비스가 사용)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# ---------------------------------------------------------------- 관리자 계정
# 최초 부팅 시 이 계정이 없으면 자동 생성된다 (scripts/bootstrap_admin.py).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_password_min_10_chars

# ---------------------------------------------------------------- 세션 / 쿠키
# Cloudflare Tunnel(HTTPS) 뒤에서 서비스할 때는 true 로 둔다.
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MIN=60

# ---------------------------------------------------------------- 로그인 방어
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- 업로드
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------- 접속 로그
# 실제 클라이언트 IP를 얻기 위해 신뢰할 프록시 홉 수.
#   Nginx 만 앞에 있을 때            : 1
#   cloudflared → Nginx 구성일 때    : 2  (CF-Connecting-IP 를 우선 사용하므로 큰 영향 없음)
TRUSTED_PROXY_COUNT=1
ACCESS_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------- 노출 범위 ★주의
# nginx 를 호스트의 어느 주소에 바인드할지 결정한다.
#   127.0.0.1 (기본) : 호스트 로컬만. 외부 공개는 Cloudflare Tunnel 이 담당한다.
#                      → 공유기에 포트를 열 필요가 없다. 이 구성이 권장값이다.
#   0.0.0.0          : LAN 전체에 공개. 호스트 전용 네트워크에서
#                      Kali 로 취약점 실습할 때만 사용한다.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080

# ---------------------------------------------------------------- Cloudflare Tunnel
# 외부 접속용 토큰. Zero Trust 대시보드에서 터널을 만들면 발급된다.
#   Networks → Tunnels → Create a tunnel → Cloudflared → 토큰 복사
#
# 이 값이 있어도 터널은 자동으로 뜨지 않는다. 명시적으로 켜야 한다:
#   docker compose --profile tunnel up -d
# vulnerable 모드 실습 중 실수로 인터넷에 노출되는 것을 막기 위한 안전장치다.
TUNNEL_TOKEN=

# ---------------------------------------------------------------- 배포 메타
# CI/CD 파이프라인이 자동으로 주입한다. 수동 실행 시에는 비워둬도 된다.
APP_VERSION=dev
GIT_COMMIT=
DEPLOYED_AT=
